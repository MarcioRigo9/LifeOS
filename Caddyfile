{
	email {$ACME_EMAIL}
}

{$APP_URL} {
	encode gzip zstd

	# Security headers (ARCHITECTURE.md §11 / SECURITY_MODEL.md). CSP is deliberately basic —
	# this is a same-origin app with no third-party embeds — tighten further only if a real
	# external asset/script is ever added.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	reverse_proxy web:3000 {
		header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format json
	}
}
