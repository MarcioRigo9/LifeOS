# Copy to .env.production on the VPS (chmod 600, never commit the real file — .gitignore
# already excludes every `.env.*` except the `*.example` templates). Read by
# docker-compose.prod.yml via `--env-file .env.production` (see DEPLOY.md).

# --- PostgreSQL role passwords (SECURITY_MODEL.md §3.1) ---------------------------------------
# lifeos_admin: superuser, used ONLY for migrations (docker-entrypoint-initdb.d, and the worker
# image's `npm run migrate` one-off). Generate with: openssl rand -hex 32
# (hex, not base64 — this password is interpolated unescaped into a postgres:// URL in
# docker-compose.prod.yml, and base64's "/", "+", "=" break URL parsing there.)
POSTGRES_ADMIN_PASSWORD=

# lifeos_runtime: the role every request-serving container (web) connects as — NOSUPERUSER,
# NOBYPASSRLS (db/init/01-roles.sql). Generate with: openssl rand -hex 32
POSTGRES_RUNTIME_PASSWORD=

# --- Application secrets -----------------------------------------------------------------------
# Reserved for future signed-cookie/CSRF work — sessions today are opaque random tokens
# (auth/session.ts), so this is not yet read by any code path. Still generate a real value now
# so rotating it later doesn't require touching this file's shape.
SESSION_SECRET=

# Real Anthropic API key — without it the Coordinator silently falls back to FakeAIProvider
# (ai-provider/fake.ts), which only echoes messages back. Required for a real deployment.
ANTHROPIC_API_KEY=

# --- Infra / reverse proxy ----------------------------------------------------------------------
# The public domain this instance is served on — consumed by the Caddyfile (automatic HTTPS via
# Let's Encrypt needs a real, DNS-resolvable domain, not an IP) and by scripts/deploy.sh for the
# post-deploy healthcheck curl. Example: nossavida.exemplo.com.br
APP_URL=

# Contact address Let's Encrypt/ACME uses for certificate expiry notices.
ACME_EMAIL=

# --- Scheduler worker (optional — sensible defaults in scheduler-worker.ts) ---------------------
# SCHEDULER_POLL_INTERVAL_MS=30000
# SCHEDULER_BATCH_SIZE=20
